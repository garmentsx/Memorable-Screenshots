{
	"compilerOptions": {
		"outDir": "dist",
		"module": "ESNext",
		"target": "ES2020",
		"jsx": "react",
		"jsxFactory": "window.SP_REACT.createElement",
		"declaration": false,
		"moduleResolution": "node",
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"strict": true,
		"skipLibCheck": true,
		"lib": ["ES2020", "DOM"]
	},
	"include": ["./frontend/**/*"],
	"exclude": ["node_modules"]
}
